use crate::core::ext::JsonExt;
use crate::core::{AppResult, BASE_PTH, BASE_ST, MARK_ST};
use serde::{Deserialize, Serialize};
use serde_inline_default::serde_inline_default;
use std::path::PathBuf;


#[serde_inline_default]
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct BaseState {
    // Client Info
    #[serde_inline_default("rBTYzmkGILyK7TF-QAJong".to_string())]
    pub client_id: String,
    #[serde_inline_default("2025.07.13.01".to_string())]
    pub client_version: String,
    
    // Pool Service
    #[serde_inline_default("http://127.0.0.1:5053".to_string())]
    pub pool_addr: String,

    // Auth Service
    #[serde_inline_default("http://127.0.0.1:5051".to_string())]
    pub auth_addr: String,
    
    // User
    #[serde_inline_default("".to_string())]
    pub default_user: String,

    // LTS Responses (data that are required for next requests)
    #[serde_inline_default(PathBuf::new())]
    pub lts_register_claims: PathBuf,
    
    #[serde_inline_default(2)]
    pub migrate_retry: u8,
    #[serde_inline_default(120)]
    pub migrate_timeout: u8,
}
impl BaseState {

    pub fn save(&self) -> AppResult<()> {
        let base_dir = BASE_PTH.get().unwrap().clone();
        self.to_path(&base_dir.join("base.json"), true)?;
        *BASE_ST.lock().unwrap() = Some(self.clone());
        Ok(())
    }

}
impl JsonExt for BaseState {}


#[serde_inline_default]
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct MarkState {
    #[serde_inline_default(Vec::new())]    
    pub mark: Vec<Marked>
}
impl JsonExt for MarkState {}
impl MarkState {

    pub fn save(&self) -> AppResult<()> {
        
        let base_dir = BASE_PTH.get().unwrap().clone();
        self.to_path(&base_dir.join("mark.json"), true)?;
        *MARK_ST.lock().unwrap() = Some(self.clone());

        Ok(())

    }

}
#[derive(Debug, Clone, Deserialize, Default, PartialEq)]
pub struct Marked {
    pub pth: String,
}

